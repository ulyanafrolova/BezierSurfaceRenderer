<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project compile on macOS/Linux; it only RUNS on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>BezierSurfaceRenderer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BezierSurfaceRenderer.Core\BezierSurfaceRenderer.Core.csproj" />
    <Using Include="BezierSurfaceRenderer.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- surfaces.txt, default texture and normal maps ship next to the .exe -->
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets" />
    <EmbeddedResource Include="Docs\Help.md" LogicalName="Help.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

</Project>
